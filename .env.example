# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_PROJECT_REF=

# PostHog
NEXT_PUBLIC_POSTHOG_HOST=
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=

# Sentry
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email (Resend)
RESEND_API_KEY=

# Site URL — used by blog:sync to call the revalidate route
NEXT_PUBLIC_SITE_URL=

# OpenAI — required for blog post embeddings (text-embedding-3-small)
OPENAI_API_KEY=

# 32-byte hex, authenticates POST /api/revalidate from cron jobs
REVALIDATE_SECRET=

# Cloudflare Turnstile — bot protection for waitlist and auth forms
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
